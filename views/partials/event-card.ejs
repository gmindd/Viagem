<%
  const past = isPastDate(event.start_date);
%>
<li class="event-card<%= past ? ' event-card--past' : '' %>">
  <a class="event-card__link" href="/e/<%= event.slug %>">
    <p class="event-card__date">
      <%= formatDate(event.start_date) %><% if (event.start_time) { %> · <%= event.start_time %><% } %>
    </p>
    <h3 class="event-card__title"><%= event.title %></h3>
  </a>

  <ul class="chips">
    <% if (event.distance_km) { %><li class="chip"><%= event.distance_km %> km</li><% } %>
    <% if (event.elevation_m) { %><li class="chip"><%= event.elevation_m %> m D+</li><% } %>
    <li class="chip"><%= labelFor(DIFFICULTIES, event.difficulty) %></li>
    <li class="chip"><%= labelFor(BIKE_TYPES, event.bike_type) %></li>
    <% if (event.visibility === 'password') { %>
      <li class="chip chip--lock">Com palavra-passe</li>
    <% } %>
    <% if (past) { %><li class="chip chip--past">Já foi</li><% } %>
  </ul>

  <p class="event-card__footer">
    <span><%= event.going_count %> confirmado<%= event.going_count === 1 ? '' : 's' %><% if (event.max_participants) { %> de <%= event.max_participants %> vagas<% } %></span>
    <% if (typeof event.owner_name !== 'undefined') { %>
      <span class="muted">por <%= event.owner_name %></span>
    <% } %>
    <% if (typeof event.my_status !== 'undefined') { %>
      <span class="badge badge--<%= event.my_status %>"><%= STATUS_LABELS[event.my_status] %></span>
    <% } %>
  </p>
</li>
