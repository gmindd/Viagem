<%
  const past = event.start_date && isPastDate(event.start_date);
  const phase = PHASES.find((p) => p.value === event.phase) || PHASES[1];
  const semData = !event.start_date;
%>
<li class="event-card event-card--<%= event.phase %><%= past ? ' event-card--past' : '' %>">
  <a class="event-card__link" href="/e/<%= event.slug %>">
    <p class="event-card__date">
      <% if (semData) { %>
        Datas por combinar
      <% } else { %>
        <%= formatDate(event.start_date) %><% if (event.start_time) { %> · <%= event.start_time %><% } %>
      <% } %>
    </p>
    <h3 class="event-card__title"><%= event.title %></h3>
  </a>

  <ul class="chips">
    <li class="chip chip--phase chip--phase-<%= event.phase %>"><%= phase.short %></li>
    <% if (event.distance_km) { %><li class="chip"><%= formatKm(event.distance_km) %> km</li><% } %>
    <% if (event.elevation_m) { %><li class="chip"><%= event.elevation_m %> m D+</li><% } %>
    <li class="chip"><%= labelFor(BIKE_TYPES, event.bike_type) %></li>
    <% if (event.visibility === 'secreto') { %><li class="chip chip--lock">Secreta</li><% } %>
    <% if (event.visibility === 'privado') { %><li class="chip chip--lock">Privada</li><% } %>
  </ul>

  <p class="event-card__footer">
    <span><%= event.member_count %> participante<%= event.member_count === 1 ? '' : 's' %><% if (event.max_participants) { %> de <%= event.max_participants %><% } %></span>
    <% if (typeof event.owner_name !== 'undefined') { %>
      <span class="muted">por <%= event.owner_name %></span>
    <% } %>
    <% if (typeof event.my_status !== 'undefined') { %>
      <span class="badge badge--<%= event.my_status %>"><%= STATUS_LABELS[event.my_status] %></span>
    <% } %>
    <% if (event.pending_count > 0) { %>
      <a class="badge badge--pending" href="/e/<%= event.slug %>#pedidos"><%= event.pending_count %> pedido<%= event.pending_count === 1 ? '' : 's' %></a>
    <% } %>
  </p>
</li>
