<!DOCTYPE html>
<html lang="pt">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="Organiza viagens de bicicleta com os teus amigos: datas, percursos, inscrições e contactos num só sítio.">
  <meta name="theme-color" content="#0f766e">
  <title><%= title %> · <%= appName %></title>
  <link rel="icon" href="/assets/images/favicon.svg" type="image/svg+xml">
  <link rel="stylesheet" href="/css/style.css">
  <script src="/js/app.js" defer></script>
</head>
<body>
  <a class="skip-link" href="#conteudo">Saltar para o conteúdo</a>

  <header class="site-header">
    <div class="container site-header__inner">
      <a class="brand" href="/">
        <span class="brand__mark" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" focusable="false">
            <circle cx="5.5" cy="17" r="3.5"></circle>
            <circle cx="18.5" cy="17" r="3.5"></circle>
            <path d="M5.5 17 10 7h4l4.5 10M9 7h6"></path>
          </svg>
        </span>
        <span class="brand__name"><%= appName %></span>
      </a>

      <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="nav-principal" aria-label="Abrir menu">
        <span class="nav-toggle__bar" aria-hidden="true"></span>
        <span class="nav-toggle__bar" aria-hidden="true"></span>
        <span class="nav-toggle__bar" aria-hidden="true"></span>
      </button>

      <nav class="nav" id="nav-principal" aria-label="Navegação principal">
        <a class="nav__link<%= currentPath === '/viagens' ? ' is-active' : '' %>" href="/viagens">Descobrir</a>
        <% if (user) { %>
          <a class="nav__link<%= currentPath === '/painel' ? ' is-active' : '' %>" href="/painel">As minhas</a>
          <%# Link permanente: um sítio de pedidos que só aparece quando há
              pedidos é um sítio que ninguém encontra quando precisa. %>
          <a class="nav__link nav__link--pedidos<%= currentPath === '/pedidos' ? ' is-active' : '' %><%= pendingTotal > 0 ? ' has-pending' : '' %>"
             href="/pedidos">
            Pedidos
            <% if (pendingTotal > 0) { %>
              <span class="nav__alert-count"><%= pendingTotal %></span>
            <% } %>
          </a>
          <a class="nav__link<%= currentPath === '/perfil' ? ' is-active' : '' %>" href="/perfil">Perfil</a>
          <a class="btn btn--primary btn--sm" href="/eventos/novo">Criar viagem</a>
          <form class="nav__form" method="post" action="/sair">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button class="btn btn--ghost btn--sm" type="submit">Sair</button>
          </form>
        <% } else { %>
          <a class="nav__link<%= currentPath === '/entrar' ? ' is-active' : '' %>" href="/entrar">Entrar</a>
          <a class="btn btn--primary btn--sm" href="/registar">Criar conta</a>
        <% } %>
      </nav>
    </div>
  </header>

  <main id="conteudo">
    <%- include('flash') %>
