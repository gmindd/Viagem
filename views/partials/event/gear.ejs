<section class="panel" id="material" aria-labelledby="titulo-material">
  <h2 id="titulo-material">Material a levar</h2>

  <% if (gear.active) { %>
    <ul class="totals">
      <li class="total">
        <span class="total__value"><%= gear.totals.claimed %>/<%= gear.totals.needed %></span>
        <span class="total__label">já garantido</span>
      </li>
      <li class="total<%= gear.totals.missing ? ' total--missing' : '' %>">
        <span class="total__value"><%= gear.totals.missing %></span>
        <span class="total__label">por atribuir</span>
      </li>
      <li class="total">
        <span class="total__value"><%= gear.byPerson.length %></span>
        <span class="total__label">a contribuir</span>
      </li>
    </ul>

    <% if (gear.totals.missing) { %>
      <p class="muted">Clica no que ficas de levar. Cada balão é uma unidade.</p>
    <% } else { %>
      <p class="alert alert--success">Está tudo atribuído. Boa!</p>
    <% } %>

    <%# Uma secção por família, cada uma com a sua cor %>
    <% gear.families.forEach((familia) => { %>
      <section class="family family--<%= familia.colour %>" aria-labelledby="familia-<%= familia.colour %>-<%= familia.name.replace(/\W+/g, '') %>">
        <h3 class="family__title" id="familia-<%= familia.colour %>-<%= familia.name.replace(/\W+/g, '') %>">
          <span class="family__dot" aria-hidden="true"></span>
          <%= familia.name %>
          <span class="family__count">
            <%= familia.needed - familia.missing %>/<%= familia.needed %>
          </span>
        </h3>

        <% if (familia.units.length) { %>
          <ul class="chips-pool">
            <% familia.units.forEach((unidade) => { %>
              <li>
                <form method="post" action="/e/<%= event.slug %>/material/<%= unidade.itemId %>/levo">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <input type="hidden" name="delta" value="1">
                  <button class="gear-chip" type="submit"
                          title="<%= unidade.notes || 'Clica para ficares com esta unidade' %>"
                          aria-label="Levar 1 × <%= unidade.name %>">
                    <span class="gear-chip__plus" aria-hidden="true">+</span>
                    <%= unidade.name %>
                  </button>
                </form>
              </li>
            <% }) %>
          </ul>
        <% } else { %>
          <p class="family__done">Tudo atribuído nesta família.</p>
        <% } %>
      </section>
    <% }) %>

    <%# O que cada pessoa ficou de levar; os balões próprios devolvem-se com um clique %>
    <% if (gear.byPerson.length) { %>
      <h3 class="participants__group">Quem leva o quê</h3>
      <ul class="who-list">
        <% gear.byPerson.forEach((p) => { %>
          <li class="who">
            <span class="avatar" aria-hidden="true"><%= p.name.trim().charAt(0).toUpperCase() %></span>
            <div class="who__body">
              <p class="who__name">
                <%= p.name %>
                <span class="who__count"><%= p.total %> unidade<%= p.total === 1 ? '' : 's' %></span>
              </p>
              <ul class="chips-pool chips-pool--mine">
                <% p.items.forEach((i) => { %>
                  <% for (let n = 0; n < i.quantity; n += 1) { %>
                    <li>
                      <% if (user && p.id === user.id) { %>
                        <form method="post" action="/e/<%= event.slug %>/material/<%= i.itemId %>/levo">
                          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                          <input type="hidden" name="delta" value="-1">
                          <button class="gear-chip gear-chip--mine family--<%= i.colour %>" type="submit"
                                  aria-label="Devolver 1 × <%= i.name %> à lista">
                            <%= i.name %>
                            <span class="gear-chip__x" aria-hidden="true">×</span>
                          </button>
                        </form>
                      <% } else { %>
                        <span class="gear-chip gear-chip--taken family--<%= i.colour %>"><%= i.name %></span>
                      <% } %>
                    </li>
                  <% } %>
                <% }) %>
              </ul>
            </div>
          </li>
        <% }) %>
      </ul>
    <% } %>

  <% } else { %>
    <p class="muted">
      Ainda não há lista de material.
      <% if (isModerator) { %>Acrescenta o que é preciso levar e quantas unidades.<% } %>
    </p>
  <% } %>

  <% if (isModerator) { %>
    <form class="form gear-add" method="post" action="/e/<%= event.slug %>/material">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="gear-add__row">
        <div class="field">
          <label for="gear_name">Artigo</label>
          <input type="text" id="gear_name" name="name" maxlength="120" required
                 placeholder="Câmara de ar">
        </div>
        <div class="field">
          <label for="gear_category">Família</label>
          <input type="text" id="gear_category" name="category" maxlength="60"
                 placeholder="Mecânica" list="familias-existentes">
          <datalist id="familias-existentes">
            <% (gear.families || []).forEach((f) => { %>
              <option value="<%= f.name %>"></option>
            <% }) %>
          </datalist>
        </div>
        <div class="field field--narrow">
          <label for="gear_quantity">Quantos</label>
          <input type="number" id="gear_quantity" name="quantity" min="1" step="1" value="1"
                 inputmode="numeric">
        </div>
        <button class="btn btn--secondary" type="submit">Acrescentar</button>
      </div>
      <div class="field">
        <label for="gear_notes">Notas <span class="optional">(opcional)</span></label>
        <input type="text" id="gear_notes" name="notes" maxlength="300"
               placeholder="Válvula Presta, 700x32">
      </div>
    </form>

    <% if (gear.active) { %>
      <details class="disclosure">
        <summary>Gerir a lista (<%= gear.items.length %> artigo<%= gear.items.length === 1 ? '' : 's' %>)</summary>
        <ul class="gear-manage">
          <% gear.items.forEach((item) => { %>
            <li class="gear-manage__item">
              <form class="gear-manage__form" method="post" action="/e/<%= event.slug %>/material/<%= item.id %>/editar">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <input type="text" name="name" value="<%= item.name %>" maxlength="120" required
                       aria-label="Nome de <%= item.name %>">
                <input type="text" name="category" value="<%= item.category %>" maxlength="60"
                       placeholder="Família" aria-label="Família de <%= item.name %>">
                <input type="number" name="quantity" value="<%= item.quantity %>" min="1" step="1"
                       aria-label="Quantidade de <%= item.name %>">
                <input type="hidden" name="notes" value="<%= item.notes %>">
                <button class="btn btn--ghost btn--sm" type="submit">Guardar</button>
              </form>
              <form method="post" action="/e/<%= event.slug %>/material/<%= item.id %>/apagar">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <button class="link-button" type="submit"
                        data-confirm="Remover <%= item.name %> da lista? As atribuições perdem-se.">Remover</button>
              </form>
            </li>
          <% }) %>
        </ul>
      </details>
    <% } %>
  <% } %>
</section>
