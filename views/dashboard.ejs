<%- include('partials/header') %>

<section class="container section">
  <header class="page-head">
    <div>
      <h1>As minhas viagens</h1>
      <p class="muted">Olá, <%= user.name %>. Aqui estão as viagens que organizas e aquelas de que fazes parte.</p>
    </div>
    <a class="btn btn--primary" href="/eventos/novo">Criar viagem</a>
  </header>

  <section class="section-block" aria-labelledby="titulo-organizo">
    <h2 class="section-title" id="titulo-organizo">Organizo eu</h2>
    <% if (owned.length) { %>
      <ul class="event-grid">
        <% owned.forEach((event) => { %>
          <%- include('partials/event-card', { event }) %>
        <% }) %>
      </ul>
    <% } else { %>
      <div class="empty">
        <p>Ainda não criaste nenhuma viagem.</p>
        <a class="btn btn--primary" href="/eventos/novo">Criar a primeira</a>
      </div>
    <% } %>
  </section>

  <section class="section-block" aria-labelledby="titulo-inscrito">
    <h2 class="section-title" id="titulo-inscrito">Faço parte</h2>
    <% if (joined.length) { %>
      <ul class="event-grid">
        <% joined.forEach((event) => { %>
          <%- include('partials/event-card', { event }) %>
        <% }) %>
      </ul>
    <% } else { %>
      <div class="empty">
        <p>Ainda não entraste em viagens de outras pessoas. Pede o link a quem organiza, ou vê as <a href="/viagens">viagens públicas</a>.</p>
      </div>
    <% } %>
  </section>
</section>

<%- include('partials/footer') %>
