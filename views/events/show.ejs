<%
  const past = event.start_date && isPastDate(event.start_date);
  const phase = PHASES.find((p) => p.value === event.phase) || PHASES[1];
  const going  = participants.filter((p) => p.status === 'going');
  const maybe  = participants.filter((p) => p.status === 'maybe');
  const out    = participants.filter((p) => p.status === 'out');
%>
<%- include('../partials/header') %>

<article class="event">
  <header class="event-hero">
    <div class="container">
      <p class="event-hero__phase">
        <span class="phase-dot phase-dot--<%= event.phase %>" aria-hidden="true"></span>
        <%= phase.label %>
      </p>

      <p class="event-hero__date">
        <% if (!event.start_date) { %>
          <% if (event.availability_start) { %>
            A decidir entre <%= formatDate(event.availability_start) %> e <%= formatDate(event.availability_end) %>
          <% } else { %>
            Datas por combinar
          <% } %>
        <% } else { %>
          <%= formatDate(event.start_date) %><% if (event.start_time) { %> · <%= event.start_time %><% } %>
          <% if (event.end_date) { %> até <%= formatDate(event.end_date) %><% } %>
        <% } %>
      </p>

      <h1><%= event.title %></h1>

      <ul class="chips chips--hero">
        <% if (event.distance_km) { %><li class="chip"><%= formatKm(event.distance_km) %> km</li><% } %>
        <% if (event.elevation_m) { %><li class="chip"><%= event.elevation_m %> m D+</li><% } %>
        <li class="chip"><%= labelFor(DIFFICULTIES, event.difficulty) %></li>
        <li class="chip"><%= labelFor(BIKE_TYPES, event.bike_type) %></li>
        <% if (event.visibility !== 'publico') { %>
          <li class="chip chip--lock"><%= labelFor(VISIBILITIES, event.visibility) %></li>
        <% } %>
        <% if (past) { %><li class="chip chip--past">Já foi</li><% } %>
      </ul>

      <p class="event-hero__owner">Organizada por <strong><%= owner.name %></strong></p>
    </div>
  </header>

  <div class="container event-layout event-layout--<%= event.phase %> section">
    <div class="event-main">

      <% if (!isMember) { %>
        <%# Sem ser membro mostra-se o mínimo: nem ponto de encontro, nem mural, nem contactos %>
        <section class="panel panel--preview">
          <h2>Sobre esta viagem</h2>
          <p class="lead"><%= phase.description %></p>
          <dl class="details">
            <div class="details__row">
              <dt>Fase</dt><dd><%= phase.label %></dd>
            </div>
            <div class="details__row">
              <dt>Participantes</dt>
              <dd><%= memberCount %><% if (event.max_participants) { %> de <%= event.max_participants %><% } %></dd>
            </div>
            <div class="details__row">
              <dt>Como se entra</dt><dd><%= labelFor(JOIN_POLICIES, event.join_policy) %></dd>
            </div>
          </dl>
          <p class="notice">
            Os detalhes — percursos, ponto de encontro, quem vai e o mural —
            só ficam visíveis para quem faz parte da viagem.
          </p>
        </section>

      <% } else { %>

        <% if (event.description) { %>
          <section class="panel" aria-labelledby="titulo-descricao">
            <h2 id="titulo-descricao">Sobre a viagem</h2>
            <p class="prose"><%= event.description %></p>
          </section>
        <% } %>

        <%# Fases de datas e propostas: combinar quando é que a viagem acontece %>
        <% if (event.phase === 'datas' || event.phase === 'propostas') { %>
          <%- include('../partials/event/calendar') %>
          <%- include('../partials/event/proposals') %>
        <% } %>

        <%# A partir da preparação, os percursos e a logística %>
        <% if (event.phase !== 'datas' && event.phase !== 'propostas') { %>
          <section class="panel" aria-labelledby="titulo-detalhes">
            <h2 id="titulo-detalhes">Detalhes</h2>
            <dl class="details">
              <div class="details__row">
                <dt>Encontro</dt>
                <dd><%= event.meeting_point || 'A combinar' %><% if (event.start_time) { %>, às <%= event.start_time %><% } %></dd>
              </div>
              <% if (event.route_url) { %>
                <div class="details__row">
                  <dt>Percurso geral</dt>
                  <dd><a href="<%= event.route_url %>" target="_blank" rel="noopener noreferrer nofollow">Abrir</a></dd>
                </div>
              <% } %>
              <div class="details__row">
                <dt>Vagas</dt>
                <dd>
                  <% if (event.max_participants) { %>
                    <%= goingCount %> de <%= event.max_participants %> ocupadas
                  <% } else { %>
                    Sem limite
                  <% } %>
                </dd>
              </div>
            </dl>

            <% if (event.max_participants) { %>
              <div class="capacity" role="img" aria-label="<%= goingCount %> de <%= event.max_participants %> vagas ocupadas">
                <span class="capacity__bar" data-capacity="<%= Math.min(100, Math.round((goingCount / event.max_participants) * 100)) %>"></span>
              </div>
            <% } %>
          </section>

          <%- include('../partials/event/routes') %>
        <% } %>

        <%# Pedidos de adesão à espera, só para quem organiza %>
        <% if (isOwner && pendingRequests.length) { %>
          <section class="panel panel--attention" id="pedidos" aria-labelledby="titulo-pedidos">
            <h2 id="titulo-pedidos">Pedidos para entrar <span class="counter"><%= pendingRequests.length %></span></h2>
            <ul class="participants">
              <% pendingRequests.forEach((r) => { %>
                <li class="participant">
                  <span class="avatar" aria-hidden="true"><%= r.name.trim().charAt(0).toUpperCase() %></span>
                  <div class="participant__body">
                    <p class="participant__name"><%= r.name %></p>
                    <% if (r.message) { %><p class="participant__note">“<%= r.message %>”</p><% } %>
                    <p class="participant__contacts">
                      <a href="mailto:<%= r.email %>"><%= r.email %></a>
                      <% if (r.phone) { %> · <%= r.phone %><% } %>
                    </p>
                  </div>
                  <div class="participant__actions">
                    <form method="post" action="/e/<%= event.slug %>/pedidos/<%= r.id %>/aceitar">
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                      <button class="btn btn--primary btn--sm" type="submit">Aceitar</button>
                    </form>
                    <form method="post" action="/e/<%= event.slug %>/pedidos/<%= r.id %>/recusar">
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                      <button class="btn btn--ghost btn--sm" type="submit"
                              data-confirm="Recusar o pedido de <%= r.name %>?">Recusar</button>
                    </form>
                  </div>
                </li>
              <% }) %>
            </ul>
          </section>
        <% } %>

        <section class="panel" id="participantes" aria-labelledby="titulo-participantes">
          <%# Enquanto se combinam datas ninguém confirmou ainda: conta o grupo todo %>
          <h2 id="titulo-participantes">
            <% if (event.phase === 'datas') { %>
              No grupo <span class="counter"><%= participants.length %></span>
            <% } else { %>
              Quem vai <span class="counter"><%= going.length %></span>
            <% } %>
          </h2>

          <% [['going', going], ['maybe', maybe], ['out', out]].forEach(([status, lista]) => { %>
            <% if (lista.length) { %>
              <h3 class="participants__group"><%= STATUS_LABELS[status] %> · <%= lista.length %></h3>
              <ul class="participants">
                <% lista.forEach((p) => { %>
                  <li class="participant">
                    <span class="avatar" aria-hidden="true"><%= p.name.trim().charAt(0).toUpperCase() %></span>
                    <div class="participant__body">
                      <p class="participant__name">
                        <%= p.name %><% if (p.user_id === owner.id) { %> <span class="tag">organiza</span><% } %>
                      </p>
                      <% if (p.note) { %><p class="participant__note"><%= p.note %></p><% } %>
                      <% if (isOwner) { %>
                        <p class="participant__contacts">
                          <a href="mailto:<%= p.email %>"><%= p.email %></a>
                          <% if (p.phone) { %> · <a href="tel:<%= p.phone.replace(/\s/g, '') %>"><%= p.phone %></a><% } %>
                          <% if (p.contact_other) { %> · <%= p.contact_other %><% } %>
                        </p>
                      <% } %>
                    </div>
                    <% if (isOwner && p.user_id !== owner.id) { %>
                      <form method="post" action="/e/<%= event.slug %>/participantes/<%= p.user_id %>/remover">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                        <button class="btn btn--ghost btn--sm" type="submit"
                                data-confirm="Remover <%= p.name %> desta viagem?">Remover</button>
                      </form>
                    <% } %>
                  </li>
                <% }) %>
              </ul>
            <% } %>
          <% }) %>

          <% if (isOwner && participants.length) { %>
            <p class="participants__export">
              <a class="btn btn--ghost btn--sm" href="/e/<%= event.slug %>/participantes.csv">Exportar contactos (CSV)</a>
            </p>
          <% } %>
        </section>

        <section class="panel" id="mural" aria-labelledby="titulo-mural">
          <h2 id="titulo-mural">Mural</h2>

          <% if (comments.length) { %>
            <ul class="comments">
              <% comments.forEach((c) => { %>
                <li class="comment">
                  <div class="comment__head">
                    <span class="comment__author"><%= c.author_name %></span>
                    <time class="comment__time"><%= formatDateTime(c.created_at) %></time>
                  </div>
                  <p class="comment__body"><%= c.body %></p>
                  <% if (user && (user.id === c.author_id || isOwner)) { %>
                    <form class="comment__actions" method="post" action="/e/<%= event.slug %>/comentarios/<%= c.id %>/apagar">
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                      <button class="link-button" type="submit" data-confirm="Apagar esta mensagem?">Apagar</button>
                    </form>
                  <% } %>
                </li>
              <% }) %>
            </ul>
          <% } else { %>
            <p class="muted">Sem mensagens. Usa o mural para combinar boleias, ritmo ou dormidas.</p>
          <% } %>

          <form class="form" method="post" action="/e/<%= event.slug %>/comentarios">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <div class="field">
              <label for="body">Escrever mensagem</label>
              <textarea id="body" name="body" rows="3" maxlength="1000" required
                        placeholder="Alguém vai de carro por Cascais?"></textarea>
            </div>
            <button class="btn btn--secondary" type="submit">Publicar</button>
          </form>
        </section>
      <% } %>
    </div>

    <aside class="event-side">
      <% if (!isMember) { %>
        <%- include('../partials/event/join-panel') %>
      <% } else { %>
        <section class="panel panel--sticky" aria-labelledby="titulo-resposta">
          <h2 id="titulo-resposta">A tua resposta</h2>

          <% if (past) { %>
            <p class="muted">Esta viagem já aconteceu.</p>
          <% } else { %>
            <% if (isFull && myParticipation?.status !== 'going') { %>
              <p class="alert alert--warning">Vagas esgotadas. Marca "Talvez" para ficares na lista de espera.</p>
            <% } %>

            <form class="form" method="post" action="/e/<%= event.slug %>/estado">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <div class="status-options">
                <% ['going', 'maybe', 'out'].forEach((status) => { %>
                  <label class="status-option status-option--<%= status %>">
                    <input type="radio" name="status" value="<%= status %>"
                           <%= (myParticipation?.status || 'going') === status ? 'checked' : '' %>>
                    <span><%= STATUS_LABELS[status] %></span>
                  </label>
                <% }) %>
              </div>

              <div class="field">
                <label for="note">Nota <span class="optional">(opcional)</span></label>
                <input type="text" id="note" name="note" maxlength="200"
                       value="<%= myParticipation?.note || '' %>" placeholder="Levo bomba e câmaras extra">
              </div>

              <button class="btn btn--primary btn--block" type="submit">Guardar resposta</button>
            </form>
          <% } %>

          <% if (!isOwner) { %>
            <form method="post" action="/e/<%= event.slug %>/sair">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <button class="link-button" type="submit" data-confirm="Sair desta viagem?">Sair da viagem</button>
            </form>
          <% } %>
        </section>
      <% } %>

      <section class="panel" aria-labelledby="titulo-partilha">
        <h2 id="titulo-partilha">Link de partilha</h2>
        <p class="muted">Envia este link a quem quiseres convidar.</p>

        <div class="share">
          <input class="share__input" type="text" value="<%= shareUrl %>" readonly
                 aria-label="Link de partilha da viagem" data-share-input>
          <button class="btn btn--secondary share__button" type="button"
                  data-copy-button data-copy-target="[data-share-input]">Copiar</button>
        </div>
        <p class="share__hint" data-copy-feedback role="status"></p>

        <% if (event.join_policy === 'palavra_passe') { %>
          <p class="notice">Esta viagem pede palavra-passe. Envia-a junto com o link.</p>
        <% } else if (event.join_policy === 'pedido') { %>
          <p class="notice">Quem abrir o link tem de pedir para entrar, e tu aprovas.</p>
        <% } %>

        <p class="share__native">
          <button class="link-button" type="button" data-share-button
                  data-share-title="<%= event.title %>" data-share-url="<%= shareUrl %>" hidden>Partilhar…</button>
        </p>
      </section>

      <% if (isOwner) { %>
        <section class="panel" aria-labelledby="titulo-gerir">
          <h2 id="titulo-gerir">Gerir</h2>
          <% if (pendingRequests.length) { %>
            <a class="btn btn--primary btn--block" href="#pedidos">
              <%= pendingRequests.length %> pedido<%= pendingRequests.length === 1 ? '' : 's' %> à espera
            </a>
          <% } %>
          <a class="btn btn--ghost btn--block" href="/e/<%= event.slug %>/definicoes">Definições da viagem</a>
        </section>
      <% } %>
    </aside>
  </div>
</article>

<%- include('../partials/footer') %>
