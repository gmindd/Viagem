<%- include('../partials/header') %>

<section class="container narrow section">
  <h1>Nova viagem</h1>
  <p class="muted">
    Não precisas de saber tudo já. Se ainda não têm data, começa na fase
    "a combinar datas" e o grupo escolhe em conjunto.
  </p>

  <%- include('../partials/errors') %>

  <form class="form panel" method="post" action="/eventos/novo" novalidate>
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">

    <%- include('../partials/event-fields') %>

    <div class="form-actions">
      <button class="btn btn--primary btn--lg" type="submit">Criar viagem</button>
      <a class="btn btn--ghost" href="/painel">Cancelar</a>
    </div>
  </form>
</section>

<%- include('../partials/footer') %>
