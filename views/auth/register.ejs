<%- include('../partials/header') %>

<section class="container narrow section">
  <article class="panel">
    <h1>Criar conta</h1>
    <p class="muted">O teu nome e contactos ficam visíveis para quem organiza os passeios em que te inscreves.</p>

    <%- include('../partials/errors') %>

    <form class="form" method="post" action="/registar" novalidate>
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">

      <div class="field">
        <label for="name">Nome</label>
        <input type="text" id="name" name="name" value="<%= values.name || '' %>" required autocomplete="name" maxlength="120">
      </div>

      <div class="field">
        <label for="email">Email</label>
        <input type="email" id="email" name="email" value="<%= values.email || '' %>" required autocomplete="email">
      </div>

      <div class="field-row">
        <div class="field">
          <label for="phone">Telemóvel</label>
          <input type="tel" id="phone" name="phone" value="<%= values.phone || '' %>" autocomplete="tel" maxlength="40" placeholder="+351 912 345 678">
        </div>
        <div class="field">
          <label for="contact_other">Outro contacto</label>
          <input type="text" id="contact_other" name="contact_other" value="<%= values.contact_other || '' %>" maxlength="120" placeholder="Instagram, Strava, Telegram…">
        </div>
      </div>
      <p class="field-hint">Preenche pelo menos um dos contactos.</p>

      <div class="field-row">
        <div class="field">
          <label for="password">Palavra-passe</label>
          <input type="password" id="password" name="password" required autocomplete="new-password" minlength="8" data-password-input>
          <p class="field-hint">Mínimo 8 caracteres.</p>
        </div>
        <div class="field">
          <label for="password_confirm">Confirmar palavra-passe</label>
          <input type="password" id="password_confirm" name="password_confirm" required autocomplete="new-password" minlength="8">
        </div>
      </div>

      <button class="btn btn--primary btn--lg btn--block" type="submit">Criar conta</button>
    </form>

    <p class="form-footer">Já tens conta? <a href="/entrar">Entra aqui</a>.</p>
  </article>
</section>

<%- include('../partials/footer') %>
