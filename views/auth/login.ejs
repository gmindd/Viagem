<%- include('../partials/header') %>

<section class="container narrow section">
  <article class="panel">
    <h1>Entrar</h1>

    <%- include('../partials/errors') %>

    <form class="form" method="post" action="/entrar" novalidate>
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">

      <div class="field">
        <label for="email">Email</label>
        <input type="email" id="email" name="email" value="<%= values.email || '' %>" required autocomplete="email" autofocus>
      </div>

      <div class="field">
        <div class="field__label-row">
          <label for="password">Palavra-passe</label>
          <a class="field__aside" href="/recuperar">Esqueci-me</a>
        </div>
        <input type="password" id="password" name="password" required autocomplete="current-password">
      </div>

      <button class="btn btn--primary btn--lg btn--block" type="submit">Entrar</button>
    </form>

    <p class="form-footer">Ainda não tens conta? <a href="/registar">Cria uma</a>.</p>
  </article>
</section>

<%- include('../partials/footer') %>
