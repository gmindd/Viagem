# Copia para .env e preenche antes de arrancar em produção.
#   cp .env.example .env

# Segredo dos cookies de sessão. OBRIGATÓRIO em produção.
# Gera um com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# URL público da app — usado para construir os links de partilha dos eventos.
BASE_URL=https://viagem.oteudominio.pt

# Nome mostrado no cabeçalho e no título das páginas.
APP_NAME=Viagem

# Porta e interface onde o Node escuta (dentro do contentor).
PORT=3000
HOST=0.0.0.0

# Caminho do ficheiro SQLite. No Docker aponta para o volume persistente.
DATABASE_FILE=/data/viagem.db

# Fuso horário usado para mostrar as horas das mensagens do mural.
TZ=Europe/Lisbon

# --- Emails (Resend) -------------------------------------------------------
# Necessário para a recuperação de palavra-passe e para os avisos de pedidos
# de adesão. Sem isto a app funciona à mesma, mas não envia emails nenhuns:
# os pedidos continuam visíveis no menu "Pedidos", e quem perder a palavra-passe
# não a consegue recuperar sozinho.
#
# 1. Cria conta em https://resend.com
# 2. Adiciona e verifica o teu domínio (Domains → Add Domain), seguindo os
#    registos DNS que te derem (SPF e DKIM).
# 3. Cria uma chave em API Keys e cola-a aqui.
RESEND_API_KEY=

# Remetente. O domínio TEM de ser um verificado no Resend, senão o envio falha.
EMAIL_FROM=Viagem <viagem@oteudominio.pt>

# --- Pontos de interesse no mapa -------------------------------------------
# Servidor Overpass usado para procurar restaurantes, dormidas e afins ao longo
# dos percursos. O valor por omissão é o serviço público da comunidade OSM;
# só muda isto se tiveres um servidor próprio.
# OVERPASS_URL=https://overpass-api.de/api/interpreter

NODE_ENV=production
